# Copy to .env and adjust. Loaded automatically by VS Code Jupyter kernels.
# Profile in ~/.databrickscfg used for local runs. Must be a token (PAT) profile,
# because the Feature Engineering client cannot use OAuth (databricks-cli) auth.
# Use the token profile directly; ignore the VS Code extension's local auth helper
# (its address goes stale after VS Code reloads -> 'metadata-service ... Connection refused').
DATABRICKS_AUTH_TYPE=pat
DATABRICKS_CONFIG_PROFILE=azure-ml-pat

# Send MLflow runs and model registrations to the Databricks workspace / Unity Catalog
MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc

# Local runs have no notebook experiment; MLflow creates this one on first use
MLFLOW_EXPERIMENT_NAME=/Users/<your-email>/ml-deployment-course-local
